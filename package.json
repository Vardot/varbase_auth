{
  "name": "varbase_auth",
  "private": true,
  "description": "Adds single sign-on using existing information from a social networking service. Such as Facebook, Twitter, LinkedIn, or Google. Built using Social API.",
  "license": "GPL-2.0-or-later",
  "engines": {
    "yarn": ">= 4.9.3",
    "node": ">= 20.0"
  },
  "keywords": [
    "Drupal",
    "Varbase",
    "single sign-on",
    "social auth"
  ],
  "author": "Vardot",
  "scripts": {
    "phpcs": "phpcs --standard=./.phpcs.xml .",
    "phpcbf": "phpcbf --standard=./.phpcs.xml .",
    "lint:yaml": "node ./node_modules/eslint/bin/eslint.js --ext .yml .",
    "spellcheck": "cspell lint ."
  },
  "devDependencies": {
    "cspell": "^8.16.1",
    "eslint": "^8.57.1",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^10.1.3",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jquery": "^1.5.1",
    "eslint-plugin-prettier": "^5.4.0",
    "eslint-plugin-yml": "^1.18.0",
    "prettier": "^3.4.2"
  },
  "packageManager": "yarn@4.9.3"
}
